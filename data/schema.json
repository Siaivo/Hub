{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siaivo.github.io/PluginHub/data/schema.json",
  "title": "PluginHub base.json",
  "description": "Схема реєстру плагінів. Унікальність id та name перевіряється case-insensitive поза JSON Schema — див. scripts/validate.mjs. JSON Schema uniqueItems не підтримує case-insensitive порівняння, тому унікальність описана тут і перевіряється скриптом.",
  "type": "array",
  "description": "Масив записів плагінів. Кожен id та name мають бути унікальними case-insensitive (перевірка в validate.mjs).",
  "items": {
    "type": "object",
    "required": ["id", "name", "description", "url", "author", "category"],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "description": "Slug, унікальний case-insensitive",
        "minLength": 2,
        "maxLength": 60,
        "pattern": "^[A-Za-z0-9._-]+$"
      },
      "name": {
        "type": "string",
        "minLength": 2,
        "maxLength": 60
      },
      "description": {
        "type": "string",
        "minLength": 20,
        "maxLength": 300
      },
      "url": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "author": {
        "type": "string",
        "minLength": 2
      },
      "category": {
        "type": "string",
        "enum": ["styles", "content", "media", "external-services", "developers"]
      }
    }
  }
}
